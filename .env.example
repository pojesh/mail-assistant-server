# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=development                  # development | production
APP_BASE_URL=http://localhost:3000   # public web URL (OAuth redirect + cookies)
SESSION_SECRET=                      # secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
TOKEN_ENCRYPTION_KEY=                # secret: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CORS_ORIGINS=http://localhost:3000
MAX_EMAILS_PER_RUN=10

# --- LLM provider ---
LLM_PROVIDER=google                  # google | groq
LLM_FAST_MODEL=gemini-3.1-flash-lite # groq: openai/gpt-oss-120b
LLM_SMART_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2
LLM_REQUESTS_PER_MINUTE=14            # shared limit for all agents (Gemini free tier: 15; Groq: ~30)
GOOGLE_API_KEY=                      # secret; required for google provider AND embeddings
GROQ_API_KEY=                        # secret; required if LLM_PROVIDER=groq

# --- Embeddings (always Google) ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Database (Supabase) ---
# URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL=                        # transaction pooler, port 6543: postgresql+asyncpg://...
CHECKPOINT_DATABASE_URL=             # session pooler, port 5432: postgresql://...

# --- Google OAuth / APIs ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_PATH=/api/auth/google/callback
GCP_PROJECT_ID=
PUBSUB_TOPIC=                        # projects/<project>/topics/gmail-push (empty locally = no Gmail watch)
INTERNAL_INVOKER_SA=                 # internal-invoker@<project>.iam.gserviceaccount.com
INTERNAL_AUDIENCE=                   # api service URL

# --- Observability (optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LOG_LEVEL=INFO

# --- Tests only ---
# Integration tests need a THROWAWAY Postgres with pgvector, never a database with real data:
#   docker run -d --name mail-assistant-testdb -e POSTGRES_PASSWORD=postgres -p 55432:5432 pgvector/pgvector:pg17
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:55432/postgres
